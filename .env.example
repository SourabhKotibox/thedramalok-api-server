PORT=3000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000/api

# Deep Linking / Share settings
APP_PACKAGE_NAME=com.xoto.app
APP_SCHEME=xoto
APP_STORE_ID=123456789

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/triple-mindes

# Redis Connection
REDIS_URI=redis://localhost:6379

# Active Storage Provider (local | aws | digitalocean)
STORAGE_DRIVER=local

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# DigitalOcean Spaces Configuration
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=

# Admin Panel Seed Credentials (used by: npm run seed-admin)
ADMIN_EMAIL=admin@tripleminds.co
ADMIN_PASSWORD=AdminPassword123!
